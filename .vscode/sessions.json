{
  "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
  "theme": "tribe",
  "active": "t2",
  "activateOnStartup": true,
  "keepExistingTerminals": false,
  "sessions": {
    "t2": [
      {
        "name": "t2",
        "autoExecuteCommands": true,
        "icon": "smiley",
        "color": "terminal.ansiGreen",
        "commands": [
          "echo hello t2!"
        ]
      },
      {
        "name": "SCRIPTS",
        "autoExecuteCommands": false,
        "icon": "folder-opened",
        "color": "terminal.ansiCyan",
        "commands": [
          "echo hello vt SCRIPTS!",
          "cd SCRIPTS",
          "uv run --with rich vt_push_vals_DRY.py"
        ]
      },
      {
        "name": "haiku",
        "autoExecuteCommands": false,
        "icon": "code",
        "color": "terminal.ansiMagenta",
        "commands": [
          "claude --model haiku"
        ]
      },
      {
        "name": "sonnet (low)",
        "autoExecuteCommands": false,
        "icon": "code",
        "color": "terminal.ansiRed",
        "commands": [
          "claude --effort low --model sonnet /git-commit-ascii"
        ]
      },
      {
        "name": "sonnet (high)",
        "autoExecuteCommands": false,
        "icon": "code",
        "color": "terminal.ansiRed",
        "commands": [
          "claude --effort high --model opusplan"
        ]
      },
      {
        "name": "opus",
        "autoExecuteCommands": false,
        "icon": "code",
        "color": "terminal.ansiYellow",
        "commands": [
          "claude --model opus"
        ]
      },
      {
        "name": "codex",
        "autoExecuteCommands": false,
        "icon": "file-code",
        "color": "terminal.ansiBlue",
        "commands": [
          "codex"
        ]
      },
      {
        "name": "opencode glm-5-turbo",
        "autoExecuteCommands": false,
        "icon": "rocket",
        "color": "terminal.ansiBlue",
        "commands": [
          "opencode --model zai-coding-plan/glm-5-turbo"
        ]
      },
      {
        "name": "opencode glm-5.1",
        "autoExecuteCommands": false,
        "icon": "versions",
        "color": "terminal.ansiRed",
        "commands": [
          "opencode --model zai-coding-plan/glm-5.1"
        ]
      },
      {
        "name": "hermes",
        "autoExecuteCommands": false,
        "icon": "hubot",
        "color": "terminal.ansiMagenta",
        "commands": [
          "hermes"
        ]
      },
      {
        "name": "serve",
        "autoExecuteCommands": false,
        "icon": "server",
        "color": "terminal.ansiGreen",
        "commands": [
          "just serve"
        ]
      },
      {
        "name": "just",
        "autoExecuteCommands": false,
        "icon": "symbol-color",
        "color": "terminal.ansiCyan",
        "commands": [
          "just "
        ]
      }
    ]
  }
}